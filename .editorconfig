[*]
charset=utf-8
# unix-style new lines but not necessarily a newLine ending every file
end_of_line=lf
insert_final_newline=false
# 4-space indents 
indent_style=space
indent_size=4

[{*.go,Makefile,*.mk,*.mkfile,*.makefile,*.make}]
indent_style=tab

[{.babelrc,jest.config,.stylelintrc,*.bowerrc,*.jsb3,*.jsb2,*.json}]
indent_style=space
indent_size=2

[{*.applejs,*.js}]
indent_style=space
indent_size=2

[{jshint.json,*.jshintrc}]
indent_style=space
indent_size=2

[{*.jscs.json,*.jscsrc}]
indent_style=space
indent_size=2

[{*.ddl,*.sql}]
indent_style=space
indent_size=2

[{*.lua}]
indent_style=space
indent_size=2

[{RecentlyViewedProductsController,Jenkinsfile,*.gson,*.gradle,*.groovy,*.gant,*.gdsl,*.gy}]
indent_style=space
indent_size=4

[*.coffee]
indent_style=space
indent_size=2

[*.less]
indent_style=space
indent_size=2

[*.scss]
indent_style=space
indent_size=2

[{*.raml,*.yml,*.yaml}]
indent_style=space
indent_size=2

[.eslintrc]
indent_style=space
indent_size=2

[{*.rhtml,*.erb}]
indent_style=space
indent_size=2

[{rake,rails,rcov,spec,spork,cucumber,Puppetfile,guardfile,vagrantfile,isolate,rakefile,gemfile,capfile,*.thor,*.rb,*.rake,*.rbw,*.ru,*.jbuilder,*.gemspec}]
indent_style=space
indent_size=2

