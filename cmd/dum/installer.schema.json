{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "playbook": {
      "properties": {
        "book": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "jetbrains": {
          "items": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "type": "array"
        },
        "plays": {
          "items": {
            "properties": {
              "description": {
                "type": "string"
              },
              "enabled": {
                "type": "boolean"
              },
              "play": {
                "type": "string"
              },
              "tasks": {
                "items": {
                  "properties": {
                    "apps": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "command": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "enabled": {
                      "type": "boolean"
                    },
                    "name": {
                      "type": "string"
                    },
                    "root": {
                      "type": "string"
                    },
                    "script": {
                      "type": "string"
                    },
                    "tap": {
                      "type": "string"
                    },
                    "target": {
                      "type": "string"
                    },
                    "task": {
                      "type": "string"
                    },
                    "type": {
                      "enum": [
                        "bash",
                        "dir",
                        "link",
                        "git",
                        "brew",
                        "cask",
                        "cellar",
                        "mas",
                        "vscode",
                        "jetbrains"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "task"
                  ],
                  "type": "object"
                },
                "type": "array"
              }
            },
            "required": [
              "play",
              "tasks"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "sudo": {
          "type": "boolean"
        }
      },
      "required": [
        "book",
        "plays"
      ],
      "type": "object"
    }
  },
  "required": [
    "playbook"
  ],
  "title": "Dum Installer Config",
  "type": "object"
